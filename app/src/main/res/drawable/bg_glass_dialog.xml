<!-- 弹窗背景：14dp圆角 + 高不透明度磨砂（80%，保证内容可读，保留玻璃质感）；
     1dp 中性灰边框保证在模糊背景上轮廓清晰 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_light_80" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/glass_panel_border" />
</shape>