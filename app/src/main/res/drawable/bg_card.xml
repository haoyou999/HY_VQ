<?xml version="1.0" encoding="utf-8"?>
<!-- 功能卡片 — 磨砂白底 + 紫晕 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_light_80" />
            <corners android:radius="18dp" />
            <stroke android:width="0.5dp" android:color="@color/glass_border_light" />
        </shape>
    </item>
    <item android:top="0dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_purple_05" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp" 
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>