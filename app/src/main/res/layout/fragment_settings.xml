<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- 设置项区：占满剩余高度并可滚动（项变多时不会被挤出屏幕） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingTop="8dp">

    <!-- 账号管理（唯一账号入口，内含连接类功能） -->
    <LinearLayout android:id="@+id/item_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_mine" android:contentDescription="账号" android:padding="9dp" android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="账号管理" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_account_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 插件（原模块设置） -->
    <LinearLayout android:id="@+id/item_module"
            android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorTertiaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_chat" android:contentDescription="插件" android:padding="9dp" android:tint="?attr/colorTertiary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="插件" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_module_count_setting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0个" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 权限管理 -->
    <LinearLayout android:id="@+id/item_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSecondaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_settings" android:contentDescription="权限" android:padding="8dp" android:tint="?attr/colorSecondary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="权限管理" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_perm_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="通知 / 房间联机" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 默认启动页 -->
    <LinearLayout android:id="@+id/item_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorTertiaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_home" android:contentDescription="默认页" android:padding="9dp" android:tint="?attr/colorTertiary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="默认启动页" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_default_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="首页" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 软件更新（网络检查 + 本地导入） -->
    <LinearLayout android:id="@+id/item_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_refresh" android:contentDescription="更新" android:padding="9dp" android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="软件更新" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_update_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v1.0 · 内置" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 关于 -->


    <!-- 存储管理 -->
    <LinearLayout android:id="@+id/item_storage" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSecondaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_settings" android:contentDescription="存储" android:padding="9dp" android:tint="?attr/colorSecondary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="存储管理" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tv_storage_state"
            android:text="" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 通知管理 -->
    <LinearLayout android:id="@+id/item_notification" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSecondaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_chat" android:contentDescription="通知" android:padding="9dp" android:tint="?attr/colorSecondary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="通知管理" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tv_notification_state"
            android:text="" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 房间联机（局域网 P2P 直连功能总开关） -->
    <LinearLayout android:id="@+id/item_terracotta"
            android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="9dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorTertiaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_chat" android:contentDescription="房间联机" android:padding="8dp" android:tint="?attr/colorTertiary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="房间联机" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_terracotta_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开启" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="6dp" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_terracotta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

    <!-- 退出登录（始终最底部） -->

    <LinearLayout android:id="@+id/item_about" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_info" android:contentDescription="关于" android:padding="9dp" android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="关于" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/tv_about_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

        </LinearLayout>
    </ScrollView>

    <!-- 退出登录：固定贴屏幕最底端（不随设置项滚动） -->
    <LinearLayout android:id="@+id/item_logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="14dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorErrorContainer">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_arrow_back" android:contentDescription="退出" android:padding="9dp" android:tint="?attr/colorError" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="退出登录" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorError" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:contentDescription="进入" />
    </LinearLayout>
</LinearLayout>
